<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%level %d{HH:mm:ss.SSS} [%t] %c - %msg%n%throwable"/>
		</Console>
	</Appenders>
	<Loggers>
		<Root level="warn"><AppenderRef ref="Console"/></Root>
	</Loggers>
</Configuration>
