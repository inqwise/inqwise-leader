<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
	<Appenders>
		<Console name="Errors" target="SYSTEM_ERR"><PatternLayout pattern="%level %logger - %msg%n%throwable"/></Console>
	</Appenders>
	<Loggers><Root level="WARN"><AppenderRef ref="Errors"/></Root></Loggers>
</Configuration>
